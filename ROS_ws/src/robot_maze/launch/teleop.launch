<launch>

  <node pkg="rosserial_python" type="serial_node.py" name="serial_node" output="screen">
    <param name="port" value="/dev/ttyACM0"/>
    <param name="baud" value="57600"/>
  </node>

 
  <include file="$(find ydlidar)/launch/lidar.launch" />

  <node pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" name="teleop_keyboard" output="screen">
    <param name="repeat_rate" value="10"/>
  </node>

 
  <!-- LiDAR -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="lidar_tf" args="0 0 0.07 0 0 0 base_link laser_frame" />

  <!-- IR Sensors -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="ir_front_tf" args="0.055 0.0 -0.056 0 0 0 base_link ir_front" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="ir_left_tf" args="0.04 0.0425 -0.056 0 0 0.785 base_link ir_left" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="ir_right_tf" args="0.04 -0.0425 -0.056 0 0 -0.785 base_link ir_right" />

  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <!-- Paramètres principaux -->
    <remap from='scan' to ="/base_scan_0"/>
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_update_interval" value="1.0"/>
    <param name="maxUrange" value="5.0"/> <!-- portée max du lidar -->
    <param name="minimumScore" value="200"/>
    <!-- À adapter selon ton LiDAR -->
    <param name="delta" value="0.05"/>  <!-- résolution de la carte en m -->
  </node>
  
</launch>
